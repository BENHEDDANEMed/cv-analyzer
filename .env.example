# Copier ce fichier en ".env" puis adapter les valeurs.

# ---------- Embeddings (Module 2) ----------
# Modèle du cahier des charges (entraîné surtout en anglais) :
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternative multilingue à comparer pour des CV en français :
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# "sentence-transformers" (par défaut) ou "tfidf" (mode hors-ligne, sans modèle)
EMBEDDING_BACKEND=sentence-transformers

# Seuils de la gap analysis (similarité cosinus)
THRESHOLD_COVERED=0.80
THRESHOLD_PARTIAL=0.55

# ---------- LLM (Module 3) ----------
# Option A : Ollama en local (gratuit) -> https://ollama.com puis "ollama pull llama3.1:8b"
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
# Option B : Groq / OpenAI (API compatible OpenAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=votre_cle
# LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60


# ---------- Sécurité / base de données ----------
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
TOKEN_TTL_HOURS=24
DATABASE_PATH=data/app.db
CORS_ORIGINS=http://localhost:5173
